NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/civicnexus
LOG_LEVEL=info
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Local Keycloak bootstrap only. Replace before starting the development stack.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-local-secret

# API token validation
OIDC_ISSUER=http://localhost:8080/realms/civicnexus
OIDC_JWKS_URI=http://localhost:8080/realms/civicnexus/protocol/openid-connect/certs
OIDC_AUDIENCE=civicnexus-api

# Browser OIDC client (public client; no client secret)
VITE_OIDC_URL=http://localhost:8080
VITE_OIDC_REALM=civicnexus
VITE_OIDC_CLIENT_ID=civicnexus-web
